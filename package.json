{
  "name": "percepta",
  "private": true,
  "version": "0.1.0",
  "description": "Percepta monorepo — run frontend + backend together with `npm run dev`",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && .\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && .\\.venv\\Scripts\\python.exe -m pytest -q",
    "test:frontend": "npm --prefix frontend run test",
    "typecheck": "npm --prefix frontend run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
